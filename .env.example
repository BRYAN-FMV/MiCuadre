# MiCuadre.app - Public Environment Variables Template
# Copy this file to .env.local and replace with your Supabase credentials

# Supabase Project URL (From Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for client-side applications)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here
